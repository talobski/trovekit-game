{
  "name": "trovekit-game",
  "private": true,
  "license": "MIT",
  "description": "An open-source card strategy game you can make your own.",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include 'content/**/*.json' server/main.ts --dev",
    "admin": "tsx watch --clear-screen=false --include 'content/**/*.json' server/admin-main.ts --dev",
    "build": "tsc -p . && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "admin:start": "NODE_ENV=production tsx server/admin-main.ts",
    "typecheck": "tsc -p .",
    "notices": "node --import tsx scripts/third-party-notices.ts",
    "release:check": "node --import tsx scripts/release-snapshot.ts",
    "release:snapshot": "node --import tsx scripts/release-snapshot.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
